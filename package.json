{
  "name": "entropy-nexus-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Entropy Nexus 記憶寶庫管理 App",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite build --mode development && electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "postinstall": "node node_modules/electron/install.js",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@fontsource-variable/noto-serif-tc": "5.3.1",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
